    },
    "This is the App Store edition: the App Store updates it, so there is no in-app updater to block. Turn off App Store automatic updates to keep the patch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the App Store edition: the App Store updates it, so there is no in-app updater to block. Turn off App Store automatic updates to keep the patch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 App Store 版微信，由 App Store 负责更新，没有可拦截的内置更新器。想保住补丁，请在 App Store 设置里关闭自动更新。"
          }
        }
      }
    },
    "This sandboxed TestFlight build checks versions and saved diagnostics only. It cannot apply or restore anti-recall patches, block WeChat updates, or repatch automatically. Catalog coverage does not mean protection is active.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sandboxed TestFlight build checks versions and saved diagnostics only. It cannot apply or restore anti-recall patches, block WeChat updates, or repatch automatically. Catalog coverage does not mean protection is active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 TestFlight 沙盒版只读检查版本与已保存的诊断。不能开启或还原防撤回、拦截微信更新或自动重打；版本收录不代表保护已生效。"
          }
        }
      }
    },
    "Turn on anti-recall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on anti-recall"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启防撤回"
          }
        }
      }
    },
    "Unknown (not supplied by older engines)": {
