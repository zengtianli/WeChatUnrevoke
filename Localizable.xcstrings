        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 内少了 wechattweak 引擎 —— 这份 WeChatUnrevoke 没构建完整，请重新下载。"
          }
        }
      }
    },
    "This WeChat build isn't covered yet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This WeChat build isn't covered yet"
