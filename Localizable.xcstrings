            "state": "translated",
            "value": "这个微信版本还没收录"
          }
        }
      }
    },
    "This WeChat build's auto-updater can't be blocked yet (its patch points aren't covered). Anti-recall is unaffected; after a WeChat update the patch is gone and this app will remind you to turn it on again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This WeChat build's auto-updater can't be blocked yet (its patch points aren't covered). Anti-recall is unaffected; after a WeChat update the patch is gone and this app will remind you to turn it on again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个微信版本暂时拦不住自动更新（更新器的补丁点还没收录）。防撤回不受影响；微信更新后补丁会失效，本 app 会提醒你重新开启。"
          }
        }
      }
    },
    "This is a historical file result, not the current state of the selected WeChat app.": {
