# macOS
.DS_Store

# Xcode / Swift build artifacts
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
.swiftpm/
.build/
__pycache__/

# Xcode per-user state (track shared project, ignore user-specific)
xcuserdata/
*.xcuserdatad

# 发布产物
dist/

# 图标中间产物（.icns 要进仓，iconset 不要）
icon/*.iconset/

# 本地开发说明与 harness 配置：含本机路径与内部约定，不进公开仓
CLAUDE.md
.claude/

# 舰队台账：内部注册表用，不属于产品本身
catalog.yaml
project.yaml

# Chapter 本机验收回执（由固定验收脚本生成，不是产品源码或发行材料）
/perf/acceptance/
/perf/delivery-evidence.json
/perf/build-receipt.json
